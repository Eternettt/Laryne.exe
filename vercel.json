{
  "rewrites": [
    { "source": "/api/auth/signup", "destination": "/api/auth?action=signup" },
    { "source": "/api/auth/login", "destination": "/api/auth?action=login" },
    { "source": "/api/auth/logout", "destination": "/api/auth?action=logout" },
    { "source": "/api/auth/me", "destination": "/api/auth?action=me" },
    { "source": "/api/account/delete", "destination": "/api/auth?action=delete-account" },
    { "source": "/api/admin/products", "destination": "/api/products?admin=1" },
    { "source": "/api/orders/by-session", "destination": "/api/orders?mode=by-session" },
    { "source": "/api/admin/orders", "destination": "/api/orders?mode=admin" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' https: data:; media-src 'self'; font-src 'self' data:; connect-src 'self' https://api.stripe.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "cleanUrls": false
}
